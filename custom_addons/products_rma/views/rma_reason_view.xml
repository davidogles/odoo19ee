<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="rma_reason_view_list" model="ir.ui.view">
        <field name="name">rma.reason.list</field>
        <field name="model">rma.reason</field>
        <field name="arch" type="xml">
            <list editable="top" string="RMA Reasons" sample="1" multi_edit="1">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    
    <record id="rma_reason_view_form" model="ir.ui.view">
        <field name="name">rma.reason.form</field>
        <field name="model">rma.reason</field>
        <field name="arch" type="xml">
            <form string="RMA Reasons">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rma_reason" model="ir.actions.act_window">
        <field name="name">RMA Reasons</field>
        <field name="res_model">rma.reason</field>
        <field name="path">rma-reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
                No RMA reasons found. Let's create one!
            </p>
        </field>
    </record>

    <menuitem id="menu_rma_reasons"
          name="RMA Reasons"
          parent="helpdesk.helpdesk_menu_config"
          action="action_rma_reason"
          groups="helpdesk.group_helpdesk_manager"/>
</odoo>