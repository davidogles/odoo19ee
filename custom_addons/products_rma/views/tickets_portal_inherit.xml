<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <template id="portal_ticket_rma_lines_inherit"
              inherit_id="helpdesk.tickets_followup"
              name="Portal Ticket RMA Lines">

        <xpath expr="//div[@id='card_body']//div[@name='description']"
               position="before">

            <t t-if="ticket.is_rma and ticket.rma_line_ids">

                <div class="row mt-4">
                    <div class="col-lg-12">

                        <div class="card">
                            <div class="card-body p-0">
                                <table class="table table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Serial</th>
                                            <th>Product</th>
                                            <th>Return Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="ticket.rma_line_ids" t-as="line">
                                            <tr>
                                                <td>
                                                    <t t-out="line.rma_lot_id.name"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.product_id.display_name"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.reason_id.name"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                </div>

            </t>

        </xpath>

    </template>
</odoo>